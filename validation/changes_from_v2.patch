+def compare(old: dict, new: dict) -> dict:
+    """Experimental paired criteria, not a significance test or hardware rating."""
+    a, b = episodes(old), episodes(new)
+    def key(s):return (float(s['requested_forward_m_s']), s.get('seed'))
