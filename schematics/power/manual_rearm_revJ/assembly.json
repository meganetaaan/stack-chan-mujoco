  "interfaces": {
    "LOGIC3V3": "upstream logic rail; power budget and independent supervision unfinished",
    "GND": "common reference; physical return routing unfinished",
    "RESET_N": "U7 and U14 open-drain outputs; independent external stop/fault sinks and physical clear acknowledgement unfinished",
    "ENABLE_PERMISSION": "logic output only; physical default-off power stage unfinished",
    "MAIN_EFUSE_EN": "TPS259823 pin6; conditional driver, brownout/default-off qualification incomplete",
    "EFUSE_INPUT_5V": "input side of eFuse; must remain within supervisor supply rating, never raw battery",
    "SEQUENCE_ENABLE_REQUEST": "unfinished startup/PG sequencer output; hardware gate also requires retained permission and RESET_N",
    "SEQUENCE_CLEAR_REQUEST": "active high U14 input; weak default asserted; actual sequencer driver and clear width unfinished",
    "BUTTON_RAW": "local PCB-only switch node; do not expose as external cable input; protection/layout unfinished",
    "LEFT_PG_SOURCE": "Input from selected eFuse PG; source-side pullup, device compatibility not fully qualified",
    "LEFT_PG_CONDITIONED": "Output to unimplemented startup sequencer; not valid during unqualified power transitions",
    "RIGHT_PG_SOURCE": "Input from selected eFuse PG; source-side pullup, device compatibility not fully qualified",
    "RIGHT_PG_CONDITIONED": "Output to unimplemented startup sequencer; not valid during unqualified power transitions"
  },
